---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import runner from '../assets/brand/runner.png';
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href?: string) => (href ? path === href : false);
const hasCurrent = (item: (typeof nav)[number]) => item.children?.some((c) => isCurrent(c.href));
---
<header class="site-header">
  <div class="container site-header__row">
    <a class="brand" href="/" aria-label="Школа двигательного развития — на главную">
      <Image src={runner} alt="" width={120} class="brand__mark" loading="eager" />
      <span class="brand__name">Школа<br />двигательного<br />развития</span>
    </a>

    <nav class="desk-nav" aria-label="Основное меню">
      <ul class="desk-nav__list">
        {nav.map((item, i) => (
          <li class="desk-nav__item">
            {item.children ? (
              <>
                <button type="button" class:list={['desk-nav__link', { 'is-current': hasCurrent(item) }]} aria-expanded="false" aria-controls={`nav-menu-${i}`} data-nav-toggle>
                  {item.label}
                  <Icon name="chevron" />
                </button>
                <ul class="desk-nav__menu" id={`nav-menu-${i}`} hidden>
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class:list={['desk-nav__link', { 'is-current': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} title={item.fullLabel}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="icon-btn" href="/posts/?search=1" aria-label="Поиск по статьям" title="Поиск по статьям"><Icon name="search" /></a>
      <button type="button" class="icon-btn site-header__burger" aria-label="Открыть меню" aria-haspopup="dialog" data-menu-open><Icon name="menu" /></button>
    </div>
  </div>
</header>

<dialog class="mobile-menu" id="mobile-menu" aria-label="Меню сайта">
  <div class="mobile-menu__head">
    <span class="mobile-menu__title">Меню</span>
    <button type="button" class="icon-btn" aria-label="Закрыть меню" data-menu-close><Icon name="close" /></button>
  </div>
  <nav aria-label="Основное меню">
    <ul class="mobile-menu__list">
      {nav.map((item) => (
        <li>
          {item.children ? (
            <details open={hasCurrent(item)}>
              <summary>{item.label}<Icon name="chevron" /></summary>
              <ul>
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a class="mobile-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.fullLabel ?? item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
    flex: none;
  }
  .brand:hover { color: var(--color-ink); }
  .brand :global(.brand__mark) { width: 60px; height: auto; mix-blend-mode: multiply; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .desk-nav { display: none; }
  .desk-nav__list { display: flex; align-items: center; gap: var(--space-1); }
  .desk-nav__item { position: relative; }
  .desk-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }
  .desk-nav__link:hover { background: var(--color-surface-strong); color: var(--color-ink); }
  .desk-nav__link.is-current {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
  .desk-nav__link :global(.icon) { width: 1em; height: 1em; transition: transform 0.15s; }
  .desk-nav__link[aria-expanded='true'] :global(.icon) { transform: rotate(180deg); }
  .desk-nav__menu {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    min-width: 19rem;
    padding: var(--space-2);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised);
  }
  .desk-nav__menu a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.3;
    text-decoration: none;
  }
  .desk-nav__menu a:hover { background: var(--color-surface-strong); }
  .desk-nav__menu a[aria-current='page'] { font-weight: 600; color: var(--color-accent-strong); }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-1); }

  @media (min-width: 1180px) {
    .desk-nav { display: block; }
    .site-header__burger { display: none; }
  }

  .mobile-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 26rem);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--space-4) var(--space-6);
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow-y: auto;
  }
  .mobile-menu::backdrop { background: rgb(22 35 63 / 0.6); }
  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
  }
  .mobile-menu__title { font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg); }
  .mobile-menu__list > li { border-top: 1px solid var(--color-border); }
  .mobile-menu__list > li:last-child { border-bottom: 1px solid var(--color-border); }
  .mobile-menu__link, .mobile-menu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding-block: var(--space-2);
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
  }
  .mobile-menu summary { list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu details[open] summary :global(.icon) { transform: rotate(180deg); }
  .mobile-menu details ul { padding: 0 0 var(--space-3) var(--space-4); }
  .mobile-menu details a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding-block: var(--space-1);
    color: var(--color-ink);
    line-height: 1.3;
    text-decoration: none;
  }
  .mobile-menu a[aria-current='page'] { color: var(--color-accent-strong); font-weight: 600; }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]');

  function closeAll(except?: HTMLButtonElement) {
    toggles.forEach((btn) => {
      if (btn === except) return;
      btn.setAttribute('aria-expanded', 'false');
      const menu = document.getElementById(btn.getAttribute('aria-controls')!);
      if (menu) menu.hidden = true;
    });
  }

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(btn);
      btn.setAttribute('aria-expanded', String(!open));
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = open;
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.desk-nav__item')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.querySelector<HTMLButtonElement>('[data-nav-toggle][aria-expanded="true"]');
    if (open) {
      closeAll();
      open.focus();
    }
  });

  document.querySelector('.desk-nav')?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Element | null;
    if (next && !next.closest('.desk-nav__item')) closeAll();
  });

  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  // Меню не должно остаться открытым, если окно расширили до десктопной раскладки
  matchMedia('(min-width: 1180px)').addEventListener('change', (e) => {
    if (e.matches && dialog.open) dialog.close();
  });
</script>
