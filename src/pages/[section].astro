---
import EmptyPage from '../components/EmptyPage.astro';
import { directions } from '../data/site';

export function getStaticPaths() {
  const sections = [
    { section: 'courses', title: 'Курсы', liveHref: '/courses' },
    { section: 'eskizy_intruktsyi', title: 'Эскизы и инструкции', liveHref: '/eskizy_intruktsyi' },
    { section: 'links', title: 'Ссылки на внешние ресурсы' },
    { section: 'reestr', title: 'ШДР-практики', liveHref: '/reestr' },
  ].map(({ section, ...props }) => ({ params: { section }, props }));

  const directionPages = directions.map((d) => ({
    params: { section: d.href.replaceAll('/', '') },
    props: { title: d.label, liveHref: d.liveHref, postsHref: `/posts/?topic=${d.id}` },
  }));

  return [...sections, ...directionPages];
}

const { title, liveHref, postsHref } = Astro.props as { title: string; liveHref?: string; postsHref?: string };
---
<EmptyPage title={title} liveHref={liveHref} postsHref={postsHref} />
