---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import PostRow from '../components/PostRow.astro';
import VideoDialog from '../components/VideoDialog.astro';
import Layout from '../layouts/Layout.astro';
import certificate from '../assets/brand/certificate.jpg';
import reader from '../assets/brand/reader.jpg';
import runner from '../assets/brand/runner.png';
import book from '../assets/shop/book.jpg';
import leonid from '../assets/team/leonid.jpg';
import lyudmila from '../assets/team/lyudmila.jpg';
import olga from '../assets/team/olga.jpg';
import regina from '../assets/team/regina.jpg';
import { directions, goals, principles, siteActions, team, TOTAL_POSTS } from '../data/site';
import { posts } from '../lib/posts';

const photos = { regina, olga, lyudmila, leonid };
const latest = posts.slice(0, 3);
---
<Layout>
  <section class="hero notebook">
    <div class="container hero__row">
      <div class="hero__copy">
        <p class="eyebrow">Образовательная программа Центра лечебной педагогики</p>
        <h1>Школа двигательного развития</h1>
        <p class="hero__lead">Помогаем понимать и поддерживать развитие движения у детей: от первых движений младенца до ходьбы, рисунка и письма, в том числе при двигательных нарушениях.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/posts/">Читать статьи <Icon name="arrow" /></a>
          <a class="btn btn--secondary" href="/courses/">Обучающие курсы</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <svg viewBox="0 0 560 400" fill="none">
          <defs>
            <filter id="pencil" x="-5%" y="-5%" width="110%" height="110%">
              <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" />
              <feDisplacementMap in="SourceGraphic" scale="2.4" />
            </filter>
          </defs>
          <g filter="url(#pencil)" stroke-linecap="round" stroke-linejoin="round">
            <path class="stroke s1" pathLength="1" stroke="#ee8a2c" stroke-width="5" d="M18 92c-3 44 4 88 8 132" />
            <path class="stroke s2" pathLength="1" stroke="#ee8a2c" stroke-width="5" d="M64 216c6-52 22-108 50-112 30-4 34 66 40 110" />
            <path class="stroke s3" pathLength="1" stroke="#c9302a" stroke-width="5" d="M214 148c-22-6-42 18-36 42 6 22 34 32 52 18 18-14 16-46-4-56-5-3-9-4-12-4" />
            <path class="stroke s4" pathLength="1" stroke="#1b4fa3" stroke-width="5" d="M30 330c40-30 66-40 96-20s52 26 84 2 62-30 100-6 76 18 120-8" />
          </g>
        </svg>
        <Image src={runner} alt="" width={640} sizes="(min-width: 1024px) 300px, 45vw" class="hero__runner" loading="eager" />
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>год основания</dt><dd>2017</dd></div>
        <div><dt>направлений</dt><dd>{directions.length}</dd></div>
        <div><dt>курсов</dt><dd>7</dd></div>
        <div><dt>материалов</dt><dd>{TOTAL_POSTS}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" id="directions" aria-labelledby="directions-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="directions-title">Направления и темы</h2>
          <p class="section-head__lead">Тематика программы – человеческое движение в различных аспектах. Выберите тему, чтобы посмотреть материалы.</p>
        </div>
      </div>
      <ul class="directions">
        {directions.map((d) => (
          <li>
            <a class="direction" href={`/posts/?topic=${d.id}`}>
              <h3>{d.label}</h3>
              <p>{d.highlights.join(' · ')}</p>
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-head">
        <h2 id="latest-title">Новые материалы</h2>
        <a class="text-link" href="/posts/">Все статьи <Icon name="arrow" /></a>
      </div>
      <ul class="latest">
        {latest.map((post) => <PostRow post={post} />)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-title">
    <div class="container approach">
      <div class="approach__intro">
        <h2 id="approach-title">О подходе ШДР</h2>
        <p>Задача программы – проведение обучающих курсов, а также подготовка и публикация материалов по двигательной тематике.</p>
      </div>
      <ol class="principles">
        {principles.map((text) => <li>{text}</li>)}
      </ol>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="goals-title">
    <div class="container goals">
      <div>
        <h2 id="goals-title">Наши цели</h2>
        <ul class="goals__list">
          {goals.map((g) => <li>{g}</li>)}
        </ul>
      </div>
      <aside class="practitioner" aria-labelledby="practitioner-title">
        <button type="button" class="practitioner__cert" data-cert-open aria-label="Посмотреть сертификат ШДР-практика">
          <Image src={certificate} alt="" width={240} sizes="120px" />
        </button>
        <div>
          <h3 id="practitioner-title">Сообщество и диплом</h3>
          <p>Выпускники ШДР сохраняют возможность профессионального диалога в нашем закрытом сообществе. Специалисты, регулярно проходящие супервизии, получают диплом ШДР-практика.</p>
          <a class="text-link" href="/reestr/">Список ШДР-практиков <Icon name="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section shop-teaser-wrap" aria-labelledby="shop-title">
    <div class="container">
      <div class="shop-teaser">
        <Image src={book} alt="Обложка книги «Младенцы в движении»" width={360} sizes="(min-width: 640px) 180px, 40vw" class="shop-teaser__cover" />
        <div class="shop-teaser__copy">
          <p class="eyebrow">Магазин ШДР</p>
          <h2 id="shop-title">Младенцы в движении</h2>
          <p>Иллюстрированный гид по развитию моторики: более 800 реальных фотографий, игры и упражнения для родителей и специалистов. А ещё предпрописи и видеолекция.</p>
          <a class="btn btn--primary" href="/shop/">Перейти в магазин <Icon name="arrow" /></a>
        </div>
        <Image src={reader} alt="" width={260} sizes="170px" class="shop-teaser__art" />
      </div>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="team-title">Руководители ШДР</h2>
          <p class="section-head__lead">Короткие видео о том, как появилась школа и в чём её подход.</p>
        </div>
      </div>
      <ul class="team">
        {team.map((m) => (
          <li class="person">
            <Image src={photos[m.photo]} alt="" width={380} sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 96px" class="person__photo" />
            <div class="person__body">
              <h3 class="person__name"><a href={m.resume}>{m.name}</a></h3>
              <p class="person__role">{m.role}</p>
              <button
                type="button"
                class="person__video"
                data-video
                data-title={m.videoTitle}
                data-person={m.name}
                data-rutube={m.rutube}
                data-youtube={m.youtube}
              >
                <Icon name="play" /> <span><span class="visually-hidden">Смотреть видео: </span>{m.videoTitle}</span>
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section welcome notebook" aria-labelledby="welcome-title">
    <div class="container">
      <h2 id="welcome-title">Добро пожаловать!</h2>
      <p class="welcome__lead">На нашем сайте вы можете:</p>
      <ul class="welcome__list">
        {siteActions.map((a) => (
          <li>{a.before} <a href={a.href}>{a.link}</a> {a.after}</li>
        ))}
      </ul>
    </div>
  </section>

  <VideoDialog />

  <dialog class="dialog cert-dialog" id="cert-dialog" aria-label="Сертификат ШДР-практика">
    <div class="dialog__head">
      <h2 class="dialog__title">Сертификат ШДР-практика</h2>
      <button type="button" class="icon-btn" aria-label="Закрыть" data-cert-close><Icon name="close" /></button>
    </div>
    <Image src={certificate} alt="Образец сертификата: специалист успешно применяет подход ШДР в развитии крупной моторики у детей с двигательными нарушениями, поддержке моторного развития младенцев и позиционировании." width={744} loading="lazy" class="cert-dialog__img" />
  </dialog>
</Layout>

<style>
  /* Первый экран */
  .hero { padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) var(--space-6); border-bottom: 1px solid var(--color-border); overflow: hidden; }
  .hero__row { display: grid; gap: var(--space-5); align-items: center; }
  .hero h1 { margin-top: var(--space-3); max-width: 13em; }
  .hero__lead { margin-top: var(--space-4); max-width: 37rem; font-size: var(--text-lg); line-height: 1.5; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  .hero__art { position: relative; max-width: 520px; width: 100%; justify-self: center; }
  .hero__art svg { display: block; width: 100%; height: auto; }
  .hero__art :global(.hero__runner) { position: absolute; right: 6%; bottom: 14%; width: 48%; mix-blend-mode: multiply; animation: arrive 0.9s var(--ease) 0.9s backwards; }
  .stroke { stroke-dasharray: 1; stroke-dashoffset: 0; animation: draw 1.1s var(--ease) backwards; }
  .s2 { animation-delay: 0.25s; }
  .s3 { animation-delay: 0.5s; }
  .s4 { animation-delay: 0.7s; animation-duration: 1.4s; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  @keyframes arrive { from { opacity: 0; transform: translateX(-24px); } }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin: var(--space-6) 0 0; }
  .stats > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: var(--space-3) var(--space-4); background: var(--color-paper); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .stats dt { color: var(--color-ink-soft); font-size: var(--text-sm); }
  .stats dd { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; line-height: 1.2; }

  /* Направления */
  .directions { display: grid; gap: var(--space-3); }
  .direction {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .direction:hover { border-color: var(--color-ink); background: var(--color-surface); color: var(--color-ink); }
  .direction h3 { font-size: var(--text-lg); }
  .direction p { color: var(--color-ink-soft); font-size: var(--text-sm); line-height: 1.4; }
  .direction :global(.icon) { position: absolute; top: var(--space-4); right: var(--space-3); color: var(--color-accent); transition: transform 0.15s; }
  .direction:hover :global(.icon) { transform: translateX(3px); }

  .latest { border-bottom: 1px solid var(--color-border); }

  /* Подход */
  .approach { display: grid; gap: var(--space-6); }
  .approach__intro p { margin-top: var(--space-4); color: var(--color-ink-soft); font-size: var(--text-lg); line-height: 1.5; }
  .principles { counter-reset: p; display: grid; gap: var(--space-5); }
  .principles li { counter-increment: p; position: relative; padding-left: 3.5rem; max-width: var(--prose); }
  .principles li::before {
    content: counter(p);
    position: absolute;
    left: 0; top: -0.2rem;
    width: 2.5rem;
    border-right: 2px solid var(--color-margin);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 2.25rem;
  }

  /* Цели */
  .goals { display: grid; gap: var(--space-6); }
  .goals__list { margin-top: var(--space-5); display: grid; gap: var(--space-4); }
  .goals__list li { padding-left: var(--space-5); position: relative; }
  .goals__list li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 12px; height: 2px; background: var(--color-accent); }
  .practitioner { display: flex; gap: var(--space-4); align-items: flex-start; padding: var(--space-5); background: var(--color-paper); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .practitioner p { margin-top: var(--space-2); font-size: var(--text-sm); }
  .practitioner__cert { flex: none; width: 88px; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: none; cursor: zoom-in; overflow: hidden; }
  .practitioner__cert:hover { border-color: var(--color-ink); }
  .cert-dialog { width: min(100% - 2rem, 34rem); }
  .cert-dialog :global(.cert-dialog__img) { width: 100%; }

  /* Магазин */
  .shop-teaser-wrap { padding-bottom: var(--section-gap); }
  .shop-teaser { display: flex; flex-wrap: wrap; gap: var(--space-5) var(--space-7); align-items: center; }
  .shop-teaser :global(.shop-teaser__cover) { width: 150px; border-radius: var(--radius-sm); box-shadow: var(--shadow-raised); }
  .shop-teaser__copy { flex: 1 1 18rem; max-width: 36rem; }
  .shop-teaser__copy h2 { margin-top: var(--space-2); }
  .shop-teaser__copy p:not(.eyebrow) { margin-block: var(--space-3) var(--space-4); }
  .shop-teaser :global(.shop-teaser__art) { display: none; width: 150px; margin-left: auto; mix-blend-mode: multiply; }

  /* Команда */
  .team { display: grid; gap: var(--space-4); }
  .person { display: flex; gap: var(--space-4); align-items: flex-start; }
  .person :global(.person__photo) { flex: none; width: 96px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-md); }
  .person__name { font-size: var(--text-lg); }
  .person__name a { color: var(--color-ink); }
  .person__role { margin-top: var(--space-1); color: var(--color-ink-soft); font-size: var(--text-sm); line-height: 1.35; }
  .person__video {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target);
    margin-top: var(--space-2);
    padding: var(--space-2) 0;
    border: 0;
    background: none;
    color: var(--color-link);
    font-weight: 500;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }
  .person__video:hover { color: var(--color-link-hover); text-decoration: underline; }

  /* Приветствие */
  .welcome__lead { margin-top: var(--space-3); font-size: var(--text-lg); }
  .welcome__list { display: grid; gap: var(--space-3) var(--space-6); margin-top: var(--space-4); }
  .welcome__list li { padding-left: var(--space-5); position: relative; max-width: 34rem; }
  .welcome__list li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 12px; height: 2px; background: var(--color-accent); }

  @media (min-width: 640px) {
    .stats { grid-template-columns: repeat(4, 1fr); }
    .directions { grid-template-columns: repeat(2, 1fr); }
    .team { grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-5); }
    .person { flex-direction: column; gap: var(--space-3); }
    .person :global(.person__photo) { width: 100%; max-width: 280px; }
    .welcome__list { grid-template-columns: repeat(2, 1fr); }
    .shop-teaser :global(.shop-teaser__cover) { width: 180px; }
  }

  @media (min-width: 900px) {
    .hero__row { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-6); }
    .approach { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-7); }
    .approach__intro { position: sticky; top: calc(var(--header-height) + var(--space-5)); align-self: start; }
    .goals { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-7); align-items: start; }
    .shop-teaser :global(.shop-teaser__art) { display: block; }
  }

  @media (min-width: 1024px) {
    .directions { grid-template-columns: repeat(4, 1fr); }
    .team { grid-template-columns: repeat(4, 1fr); }
    .welcome__list { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  const cert = document.getElementById('cert-dialog') as HTMLDialogElement;
  document.querySelector('[data-cert-open]')!.addEventListener('click', () => cert.showModal());
  document.querySelector('[data-cert-close]')!.addEventListener('click', () => cert.close());
  cert.addEventListener('click', (e) => { if (e.target === cert) cert.close(); });
</script>
